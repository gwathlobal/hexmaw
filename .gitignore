# Project-local Quicklisp (Trial comes from the Shirakumo dist)
/.ql

# A checkout's own eval port (tools/hd, run.sh, the reload hook)
/.eval-port

# Compiled Lisp
*.fasl
*.fas
*.lx64fsl

# Runtime output
/screenshots/
/bin/
/dist/
*.log
.cache/

# Python bytecode
__pycache__/

# Blender backups and render output (regenerated by tools/blender_sword.py)
*.blend1
/art/sword-blender/
/art/sword-pixel/
/art/sword-renders/

# Stacked animation sheets (tools/stack_views.py), rebuilt from the per-view sheets;
# tools/slice_views.py slices without writing them
/art/**/*-sheet.png
/art/imp/Imp * Sheet.png

# Audio sources, takes and loops (tools/gen_music.py, gen_sfx.py, make_loop.py, compose_*.py);
# each rebuilds from its .prompt.json or script, and the game plays data/music/*.ogg
/audio/**/*.wav

# Working notes, not part of the product
/ROADMAP.md
