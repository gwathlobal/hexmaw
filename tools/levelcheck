#!/usr/bin/env python3
"""Build generated levels and kit blocks with no window, and report what they hold and what
their checks found (src/levelcheck.lisp). Each worker is a plain SBCL process: no window, GL,
music or sound, no eval server, no settings or saves, so several run at once, and in CI.

    tools/levelcheck                         # runs 1-10, every level of each
    tools/levelcheck --runs 1-100 --depths 1,2 --jobs 6
    tools/levelcheck --kit                   # check-kit: every block alone
    tools/levelcheck --kit cave grotto       # these blocks
    tools/levelcheck --runs 1-30 --json > levels.jsonl
    tools/levelcheck --runs 1-3 --kit --strict

A run's levels come from its seed, as a game's do (`level-seed`), so `--runs 5` is the run a
game with `*level-seed*` 5 plays, and its levels are those that game builds. The report has a
line per level, its warnings under it, then a summary per depth and the warnings by class.
`--json` prints the workers' records instead, one JSON object a line. `--strict` exits 1 on a
worker error, a kit problem, a doorway the player can't walk to, a stranded creature other
than an ogre, an ice gate joined wrong, a doorway opening onto nothing, a doorway a rooted
creature (a bloodroot) cuts off, or a level with no way off after every seed it may try. Stranded ogres are expected (CLAUDE.md, "The ogre").

Stale blueprints are built first (tools/blueprint --stale), so the workers never write blocks.
"""

import argparse
import json
import os
import re
import statistics
import subprocess
import sys
import tempfile
import threading
import time
from collections import Counter, defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# Warnings the structured checks already cover (or that only say a seed was retried).
KNOWN = re.compile(r"can't walk to the spawn point|Can't walk to .* from the spawn point|"
                   r"Ice gate joined|trying another seed|No level that will do|opens onto nothing|"
                   r"A rooted creature cuts")
EXPECTED_STRANDED = {'ogre', 'elite-ogre'}


def parse_numbers(spec):
    """1-5,8,10-12 -> [1, 2, 3, 4, 5, 8, 10, 11, 12]."""
    out = []
    for part in spec.split(','):
        part = part.strip()
        if not part:
            continue
        if '-' in part:
            a, b = part.split('-', 1)
            out.extend(range(int(a), int(b) + 1))
        else:
            out.append(int(part))
    return out


def lisp_list(items, strings=False):
    if strings:
        return "(list " + " ".join('"%s"' % re.sub(r'[\\"]', '', s) for s in items) + ")"
    return "(list " + " ".join(str(int(i)) for i in items) + ")"


def worker_form(runs, depths, kit, blocks):
    args = [":runs " + lisp_list(runs)]
    if depths:
        args.append(":depths " + lisp_list(depths))
    if kit:
        args.append(":kit t")
        if blocks:
            args.append(":blocks " + lisp_list(blocks, strings=True))
    return "(hexmaw::levelcheck-worker %s)" % " ".join(args)


def compiled_p():
    """True if ASDF's cache for this checkout holds a fasl for every file of the game newer than
    that file and every file before it (the system is serial: a change recompiles all after it).
    Otherwise the first worker compiles them, and the rest wait for it: workers compiling side by
    side would write the same fasls at once."""
    order = ['blueprint'] + re.findall(r'\(:file "([^"]+)"\)', (ROOT / 'hexmaw.asd').read_text())
    for cache in (Path.home() / '.cache' / 'common-lisp').glob('sbcl-*'):
        fasls = cache / str(ROOT).lstrip('/') / 'src'
        if not fasls.is_dir():
            continue
        newest = max((ROOT / a).stat().st_mtime for a in ('hexmaw.asd', 'hexmaw-blueprints.asd'))
        for name in order:
            newest = max(newest, (ROOT / 'src' / (name + '.lisp')).stat().st_mtime)
            fasl = fasls / (name + '.fasl')
            if not fasl.exists() or fasl.stat().st_mtime < newest:
                break
        else:
            return True
    return False


class Worker:
    def __init__(self, index, form, on_record):
        self.index = index
        self.log = tempfile.NamedTemporaryFile('w+', prefix='levelcheck-%d-' % index, suffix='.log', delete=False)
        self.proc = subprocess.Popen(
            ['sbcl', '--dynamic-space-size', '4096', '--noinform', '--no-userinit', '--non-interactive',
             '--eval', '(sb-ext:disable-debugger)', '--load', 'boot.lisp', '--eval', form],
            cwd=ROOT, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=self.log, text=True)
        self.ready = threading.Event()
        self.thread = threading.Thread(target=self.read, args=(on_record,), daemon=True)
        self.thread.start()

    def read(self, on_record):
        for line in self.proc.stdout:
            # Anything else on standard output (a compile's chatter) isn't a record.
            if line.startswith('{'):
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if record.get('ready'):
                    self.ready.set()
                else:
                    on_record(record)
        self.ready.set()

    def wait(self):
        code = self.proc.wait()
        self.thread.join()
        return code

    def tail(self, lines=25):
        self.log.flush()
        with open(self.log.name) as f:
            return ''.join(f.readlines()[-lines:])


def classify(record):
    """The (class, text) of each finding in a level's or block's RECORD; class names ending
    in ! fail --strict."""
    found = []
    if 'error' in record:
        found.append(('error!', record['error']))
        return found
    if 'block' in record:
        for p in record['problems']:
            found.append(('kit problem!', p))
        for w in record['warnings']:
            found.append(('kit warning', w))
        return found
    if record['problem']:
        found.append(('no level that will do!', 'kept seed %s, which %s' % (record['seed'], record['problem'])))
    if record['attempts'] > 1:
        found.append(('retried', '%d seeds tried' % record['attempts']))
    if record['unreachable']:
        found.append(('unreachable doorway!', '%d doorways' % record['unreachable']))
    for c in record['stranded']:
        found.append(('stranded ogre' if c in EXPECTED_STRANDED else 'stranded creature!', c))
    if record['ice_joins']:
        found.append(('ice join!', '%d joins' % record['ice_joins']))
    if record.get('blocked_by_rooted'):
        found.append(('blocked by a rooted creature!', '%d doorways' % record['blocked_by_rooted']))
    for w in record['warnings']:
        if 'opens onto nothing' in w:
            found.append(('doorway onto nothing!', w))
        elif not KNOWN.search(w):
            found.append(('other warning', w))
    return found


def level_line(r):
    if 'error' in r:
        return 'run %d depth %d: ERROR %s' % (r['run'], r['depth'], r['error'])
    res = r['resources']
    nets = ', '.join('%s %d' % (n['family'], n['pieces']) for n in r['networks'])
    town = r['settlement']
    extra = []
    if town:
        extra.append('town %s (%s, %s)' % (town['name'], town['faction'], town['condition']))
    if r['boss']:
        extra.append('boss %s' % r['boss'])
    return ('run %-4d d%d seed %-20s %3d rooms %3d blocks %3d monsters (%d elite) %3d pickups  '
            'hp %4d mp %4d gold %4d dust %3d%s%s  %.2fs' % (
                r['run'], r['depth'], r['seed'], r['rooms'], r['blocks'], r['monsters'], r['elites'],
                r['pickups'], res.get('health', 0), res.get('mana', 0), res.get('gold', 0), res.get('dust', 0),
                '  ' + nets if nets else '', '  ' + '; '.join(extra) if extra else '', r['seconds']))


def spread(values):
    if not values:
        return '-'
    return '%.1f (%g-%g)' % (statistics.mean(values), min(values), max(values))


def summary(levels, out):
    # The settlement's level (depth 2 or 3, by the run) is a small one of its own: apart.
    by_depth = defaultdict(list)
    for r in levels:
        if 'error' not in r:
            by_depth[(r['depth'], bool(r['settlement']))].append(r)
    for depth, town in sorted(by_depth):
        rs = by_depth[(depth, town)]
        n = len(rs)
        print('\nDepth %d%s: %d levels' % (depth, ', the settlement' if town else '', n), file=out)
        for label, key in [('rooms', lambda r: r['rooms']), ('blocks', lambda r: r['blocks']),
                           ('monsters', lambda r: r['monsters']), ('elites', lambda r: r['elites']),
                           ('pickups', lambda r: r['pickups']),
                           ('health', lambda r: r['resources'].get('health', 0)),
                           ('mana', lambda r: r['resources'].get('mana', 0)),
                           ('gold', lambda r: r['resources'].get('gold', 0)),
                           ('dust', lambda r: r['resources'].get('dust', 0)),
                           ('seeds tried', lambda r: r['attempts']),
                           ('seconds', lambda r: r['seconds'])]:
            print('  %-12s %s' % (label, spread([key(r) for r in rs])), file=out)
        tiers = defaultdict(int)
        for r in rs:
            for tier, k in r.get('rune_tiers', {}).items():
                tiers[tier] += k
        if tiers:
            print('  %-12s %s' % ('rune tiers', ', '.join('%s %d' % (t, tiers[t]) for t in ('free', 'stamina', 'mana')
                                                           if t in tiers)), file=out)
        families = defaultdict(list)
        for r in rs:
            for f in {net['family'] for net in r['networks']}:
                families[f].append(sum(net['pieces'] for net in r['networks'] if net['family'] == f))
        for f in sorted(families):
            print('  %-12s %3.0f%% of levels, %s blocks' % (f, 100.0 * len(families[f]) / n, spread(families[f])),
                  file=out)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    ap.add_argument('--runs', help='run seeds, as 1-10,15 (default 1-10, or none with --kit)')
    ap.add_argument('--depths', default='all', help='which levels of each run: all, or as 1,3')
    ap.add_argument('--kit', nargs='*', metavar='BLOCK', help='check every block alone (or these)')
    ap.add_argument('--jobs', type=int, default=min(4, os.cpu_count() or 1), help='worker processes (default 4)')
    ap.add_argument('--json', action='store_true', help="print the workers' JSON records, one a line")
    ap.add_argument('--notes', action='store_true', help="show the generator's info lines under each level")
    ap.add_argument('--strict', action='store_true', help='exit 1 on any finding that is a bug')
    args = ap.parse_args()

    kit = args.kit is not None
    runs = parse_numbers(args.runs) if args.runs else ([] if kit else list(range(1, 11)))
    depths = None if args.depths == 'all' else parse_numbers(args.depths)
    jobs = max(1, min(args.jobs, len(runs) + (1 if kit else 0)))

    built = subprocess.run([str(ROOT / 'tools' / 'blueprint'), '--stale'], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True)
    sys.stderr.write(built.stdout)
    if built.returncode != 0:
        sys.stderr.write(built.stderr)
        print('levelcheck: a blueprint failed to build', file=sys.stderr)
        return 1

    records = []
    lock = threading.Lock()
    started = time.time()

    def on_record(record):
        with lock:
            records.append(record)
            if sys.stderr.isatty():
                sys.stderr.write('\r%d records, %.0f s ' % (len(records), time.time() - started))
                sys.stderr.flush()

    # Runs dealt out in turn, so each worker gets a share of every kind; the kit to the first.
    shares = [runs[i::jobs] for i in range(jobs)]
    workers = []
    for i, share in enumerate(shares):
        workers.append(Worker(i, worker_form(share, depths, kit and i == 0, args.kit), on_record))
        if i == 0 and jobs > 1 and not compiled_p():
            print('levelcheck: compiling the game in the first worker before starting the rest', file=sys.stderr)
            workers[0].ready.wait()
    failed = []
    for w in workers:
        code = w.wait()
        if code != 0:
            failed.append(w)
        else:
            os.unlink(w.log.name)
    elapsed = time.time() - started
    if sys.stderr.isatty():
        sys.stderr.write('\r')

    levels = sorted((r for r in records if 'run' in r), key=lambda r: (r['run'], r['depth']))
    blocks = sorted((r for r in records if 'block' in r), key=lambda r: r['block'])
    if args.json:
        for r in blocks + levels:
            print(json.dumps(r))
    else:
        out = sys.stdout
        if blocks:
            bad = [b for b in blocks if b.get('problems') or 'error' in b]
            print('Kit: %d blocks, %d with problems' % (len(blocks), len(bad)), file=out)
            for b in bad:
                for cls, text in classify(b):
                    print('  %s: %s: %s' % (b['block'], cls.rstrip('!'), text), file=out)
        for r in levels:
            print(level_line(r), file=out)
            if 'error' not in r:
                for w in r['warnings']:
                    print('    ! ' + w, file=out)
                if args.notes:
                    for n in r['notes']:
                        print('    . ' + n, file=out)
        if levels:
            summary(levels, out)

    findings = Counter()
    for r in blocks + levels:
        for cls, _ in classify(r):
            findings[cls] += 1
    for w in failed:
        findings['worker failed!'] += 1
    report = sys.stderr if args.json else sys.stdout
    print('\n%d levels and %d blocks in %.0f s with %d worker%s.' % (
        len(levels), len(blocks), elapsed, jobs, '' if jobs == 1 else 's'), file=report)
    for cls, n in sorted(findings.items()):
        print('  %-24s %d' % (cls.rstrip('!') + (' (fails --strict)' if cls.endswith('!') else ''), n), file=report)
    for w in failed:
        print('\nWorker %d exited %d; the end of its log (%s):\n%s' % (w.index, w.proc.returncode, w.log.name, w.tail()),
              file=sys.stderr)
    if args.strict and any(cls.endswith('!') for cls in findings):
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
