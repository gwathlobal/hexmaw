#!/usr/bin/env bash
# Talk to the running game's eval server.
#
#   tools/hd status                  where the player is, error count
#   tools/hd reload src/player.lisp  compile one file and load it into the game
#   tools/hd reload-system           reload everything through ASDF
#   tools/hd reset                   rebuild the scene (player keeps position)
#   tools/hd screenshot              save the current frame, print its path
#   tools/hd errors                  recent runtime errors with backtraces
#   tools/hd '(form)'                evaluate any form in package HEXMAW;
#                                    wrap scene changes in (game ...)
#
# Exit codes: 0 ok, 1 the request failed (message on stderr), 3 game not running.

port="${HEXMAW_EVAL_PORT:-7171}"

lisp_string() {
  local s="${1//\\/\\\\}"
  printf '"%s"' "${s//\"/\\\"}"
}

case "$1" in
  status)        form='(status)' ;;
  reload)        form="(reload-file $(lisp_string "$2"))" ;;
  reload-system) form='(reload-system)' ;;
  reset)         form='(reload-scene)' ;;
  screenshot)    form='(screenshot)' ;;
  errors)        form='(runtime-errors)' ;;
  ""|-h|--help)  sed -n '2,13p' "$0"; exit 0 ;;
  *)             form="$1" ;;
esac

# The group scopes 2>/dev/null; on a bare exec it would silence the script's stderr for good.
if ! { exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null; then
  echo "hexmaw is not running (nothing listening on 127.0.0.1:$port). Start it with ./run.sh" >&2
  exit 3
fi
printf '%s\n' "$form" >&3
IFS= read -r status <&3
body="$(cat <&3)"
exec 3<&-

if [ "$status" = OK ]; then
  printf '%s\n' "$body"
else
  printf '%s\n' "${body:-No response from the game.}" >&2
  exit 1
fi
