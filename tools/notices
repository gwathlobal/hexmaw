#!/usr/bin/env bash
# Write THIRD-PARTY-NOTICES.txt from the dependency tree and notices/ (tools/notices.lisp),
# or, with --check, fail when it is out of date or a library's licence is missing or a
# copyleft one the build isn't allowed to ship. CI runs --check on every platform.
#
#   tools/notices [--check]
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root" || exit 1
check=NIL
[ "${1:-}" = "--check" ] && check=T
exec sbcl --dynamic-space-size 4096 --noinform --no-userinit --non-interactive \
     --load boot.lisp --eval "(sb-ext:disable-debugger)" --load tools/notices.lisp \
     --eval "(hexmaw-notices:main :check $check)"
